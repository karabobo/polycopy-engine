# Rust build products
/target/

# Runtime state: it belongs on local storage and must never be committed.
/.data/
/runtime/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Credentials and live-order material. Keep documented examples tracked.
# These patterns also protect misplaced nested deploy/test .env files.
.env
.env.*
*.env
*.env.*
!/.env.example
/secrets/
/keys/
*.pem
*.p12
*.pfx
*.key

# Deliberately generated operational evidence; commit a redacted Markdown
# report instead of raw signed envelopes, request bodies, or wallet snapshots.
/artifacts/
/canary-artifacts/
/ghost-artifacts/
.DS_Store

# Bootstrap clone used only to create the fixed, archive-only official SDK
# source below. The source directory itself is deliberately tracked.
/vendor/polymarket_client_sdk_v2/
# Build products from an occasional standalone vendored-SDK test run.
/vendor/polymarket_client_sdk_v2_source/target/

# Live copy-trading configuration: real Leader and funder addresses. Publishing
# them hands over both the screening pipeline's output and an on-chain account
# that can be watched -- and front-run -- trade by trade. The example beside it
# carries every tuning value with the addresses zeroed.
/deploy/trading-config.json
