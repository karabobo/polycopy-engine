# Phase 0 GHOST verification configuration.
#
# Copy this file to `.env` (already gitignored) and fill in real values there.
# NEVER put a real private key in this file, never commit `.env`, and never
# paste the private key into chat/AI tools — it must only ever live in your
# local shell environment.
#
# Load it before running the verifier, e.g.:
#   set -a; source .env; set +a
#   cargo run --locked --features intl_clob --bin ghost_verify

# The Polymarket CLOB signing key for the account being verified.
# Leave this line as a placeholder in any file that gets shared or committed.
POLYCOPY_CLOB_PRIVATE_KEY=

# How the signing key relates to the funded Polymarket account:
#   eoa         - the signing wallet IS the funded account (direct browser
#                 wallet connect, e.g. MetaMask/Rainbow with on-chain funds).
#   proxy       - Polymarket's email/magic-link login; the signing key
#                 controls a separate proxy wallet that holds the funds.
#   gnosis_safe - funds are held in a Gnosis Safe controlled by the signer.
#   poly1271    - funder is a smart-contract wallet verified via EIP-1271;
#                 GHOST-only until Phase 0.5 proves venue behavior.
POLYCOPY_CLOB_SIGNATURE_TYPE=eoa

# Required for proxy/gnosis_safe/poly1271, must be UNSET for eoa.
# This is the funded account address shown in Polymarket's UI, not your
# signing key's own address (unless you are using eoa mode).
POLYCOPY_CLOB_FUNDER=

# UTC timestamp (RFC 3339, must end in Z) for when you captured the manual
# wallet snapshot below, e.g. 2026-08-30T00:00:00Z.
POLYCOPY_GHOST_SNAPSHOT_AT_UTC=

# Manually read from the Polymarket UI at the snapshot timestamp above.
POLYCOPY_GHOST_EXPECTED_COLLATERAL=
# Comma-separated outcome_token_id=balance pairs, e.g. 123456789=1.5,987654321=0
POLYCOPY_GHOST_EXPECTED_TOKEN_BALANCES=

# Only set these if deriving a NEW-nonce existing credential (rare):
# POLYCOPY_CLOB_L2_NONCE=

# Only set ALL THREE of these if you already have an existing L2 API
# credential and want to skip derivation (leave unset to derive by default):
# POLYCOPY_CLOB_L2_API_KEY=
# POLYCOPY_CLOB_L2_API_SECRET=
# POLYCOPY_CLOB_L2_API_PASSPHRASE=
